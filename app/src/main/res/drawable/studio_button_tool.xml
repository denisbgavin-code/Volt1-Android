<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#14171B" />
            <stroke android:width="1dp" android:color="#1E2228" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2B313A" />
            <stroke android:width="1dp" android:color="#5CDCA5" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2228" />
            <stroke android:width="1dp" android:color="#323842" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
