<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0D10"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="VOLT // EDIT"
                android:textColor="#5CDCA5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/backToRecorder"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/studio_button_secondary"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="← RECORDER"
                android:textAllCaps="false"
                android:textColor="#D8DDE5"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Waveform Editor"
            android:textColor="#F4F7FA"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Non-destructive trim • PCM24 / 48 kHz"
            android:textColor="#8C95A3"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/studio_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="SOURCE TAKE"
                android:textColor="#8C95A3"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/recordingSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/studio_button_secondary"
                android:popupBackground="#171A1F"
                android:spinnerMode="dropdown" />

            <Button
                android:id="@+id/refreshRecordings"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/studio_button_secondary"
                android:stateListAnimator="@null"
                android:text="REFRESH FILES"
                android:textAllCaps="false"
                android:textColor="#D8DDE5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/editorFileInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="No file selected"
                android:textColor="#B9C1CC"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/studio_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="TIMELINE"
                    android:textColor="#8C95A3"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DRAG HANDLES"
                    android:textColor="#5CDCA5"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.volt1.recorder.WaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginTop="10dp"
                android:background="#101318"
                android:contentDescription="Waveform and trim selection" />

            <TextView
                android:id="@+id/selectionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:text="IN  —&#10;OUT —&#10;LEN —"
                android:textColor="#F4F7FA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/studio_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECTION"
                android:textColor="#8C95A3"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="IN"
                android:textColor="#B9C1CC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/startSeek"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:max="10000"
                android:progressBackgroundTint="#2D323B"
                android:progressTint="#5CDCA5"
                android:thumbTint="#5CDCA5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="OUT"
                android:textColor="#B9C1CC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/endSeek"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:max="10000"
                android:progress="10000"
                android:progressBackgroundTint="#2D323B"
                android:progressTint="#5CDCA5"
                android:thumbTint="#5CDCA5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/playSelection"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.45"
                android:background="@drawable/studio_button_secondary"
                android:stateListAnimator="@null"
                android:text="▶  PLAY SELECTION"
                android:textAllCaps="false"
                android:textColor="#F4F7FA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/stopPlayback"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/studio_button_secondary"
                android:stateListAnimator="@null"
                android:text="■  STOP"
                android:textAllCaps="false"
                android:textColor="#F4F7FA"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/saveSelection"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/studio_button_accent"
            android:stateListAnimator="@null"
            android:text="TRIM TO SELECTION • SAVE COPY"
            android:textAllCaps="false"
            android:textColor="#0B0D10"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/editorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/studio_card"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="Loading…"
            android:textColor="#B9C1CC"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="The original take is never modified. Trim creates a new PCM24 / 48 kHz WAV by copying complete PCM frames; no codec or sample-rate conversion is applied."
            android:textColor="#69717D"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
