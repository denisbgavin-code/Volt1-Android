<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0D10"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="VOLT // STUDIO"
                android:textColor="#5CDCA5"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="v0.4"
                android:textColor="#7F8793"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="USB Audio Recorder"
            android:textColor="#F4F7FA"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="○ Volt 1 offline"
            android:textColor="#8C95A3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="24-bit / 48 kHz WAV • Input 1"
            android:textColor="#69717D"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/studio_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="WAVEFORM"
                    android:textColor="#8C95A3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/recordState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="○ OFFLINE"
                    android:textColor="#7F8793"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/recordTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="00:00:00.0"
                    android:textColor="#F4F7FA"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/peakValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="— dBFS"
                    android:textColor="#F4F7FA"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.volt1.recorder.UnifiedWaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="#101318"
                android:contentDescription="Live and editable audio waveform" />

            <com.volt1.recorder.LevelMeterView
                android:id="@+id/meter"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="EDIT: drag vertical handles • pinch to zoom • drag background to pan"
                android:textColor="#626A76"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/start"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1.7"
                android:background="@drawable/studio_button_record"
                android:enabled="false"
                android:stateListAnimator="@null"
                android:text="●  RECORD"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/stop"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/studio_button_secondary"
                android:enabled="false"
                android:stateListAnimator="@null"
                android:text="■  STOP"
                android:textAllCaps="false"
                android:textColor="#F4F7FA"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/studio_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CURRENT AUDIO"
                android:textColor="#8C95A3"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:maxLines="2"
                android:text="No file loaded"
                android:textColor="#F4F7FA"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/openFile"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/studio_button_accent"
                    android:stateListAnimator="@null"
                    android:text="OPEN WAV"
                    android:textAllCaps="false"
                    android:textColor="#0B0D10"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/fitWaveform"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/studio_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="FIT"
                    android:textAllCaps="false"
                    android:textColor="#F4F7FA"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playSelection"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/studio_button_secondary"
                    android:enabled="false"
                    android:stateListAnimator="@null"
                    android:text="▶  PLAY RANGE"
                    android:textAllCaps="false"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/stopPlayback"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/studio_button_secondary"
                    android:enabled="false"
                    android:stateListAnimator="@null"
                    android:text="■  STOP PLAY"
                    android:textAllCaps="false"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/deleteSelection"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/studio_button_record"
                android:enabled="false"
                android:stateListAnimator="@null"
                android:text="DELETE SELECTED RANGE"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/cropSelection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/studio_button_secondary"
                android:enabled="false"
                android:stateListAnimator="@null"
                android:text="CROP TO RANGE"
                android:textAllCaps="false"
                android:textColor="#F4F7FA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/saveAs"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/studio_button_accent"
                android:enabled="false"
                android:stateListAnimator="@null"
                android:text="SAVE AS NEW WAV"
                android:textAllCaps="false"
                android:textColor="#0B0D10"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
