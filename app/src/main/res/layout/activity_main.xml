<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F6F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volt 1 Recorder"
            android:textColor="#111111"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="PCM WAV • 24 bit • 48 000 Hz • mono"
            android:textColor="#555555"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Поиск Volt 1…"
            android:textColor="#222222"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Обновить устройство" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Готово"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="Peak: — dBFS"
            android:textColor="#333333"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/meter"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:max="120"
            android:progress="0" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="30dp"
            android:enabled="false"
            android:text="ЗАПИСЬ"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="СТОП"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Файл: —"
            android:textColor="#555555"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openEditor"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="РЕДАКТОР АУДИО"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Запись начинается только если Android подтверждает фактический USB-маршрут через Volt 1, аппаратную частоту 48 кГц и формат выше 16 бит. При смене маршрута, ресэмплинге, системной обработке или отключении USB запись останавливается."
            android:textColor="#666666"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
